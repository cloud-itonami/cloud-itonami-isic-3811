{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep, all
 ;; .cljc → portable to JVM / SCI / ClojureScript / GraalVM). Both live in
 ;; the kotoba-lang org of this workspace (kotoba wasm → clojurewasm →
 ;; ClojureScript → nbb runtime priority, CLAUDE.md).
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "0ffd5f6340af50871d4759b06e02ac4fbf9a4bdf"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        ;; langchain-store: the shared langchain.db store seam (EDN-blob
        ;; codec + identity schema + event-log read/append helpers) that
        ;; ~190 cloud-itonami actors hand-roll (ADR-2607141600);
        ;; wastecollect.store's DatomicStore uses it instead of its own
        ;; enc/dec* two-liner.
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}
        ;; carrier-licence-gate の判定元(cited fact table)。この actor は
        ;; 「この pickup は安全か」しか見ていなかったので、「そもそも運搬して
        ;; よいのか」を答える層を外から入れる。ここで法的結論を再実装しない。
        io.github.cloud-itonami/cloud-itonami-licensed-operator
        {:local/root "../cloud-itonami-licensed-operator"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  → drive the demo through one OperationActor
  :run {:main-opts ["-m" "wastecollect.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis — clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
